# ---------------------------------------------------------------------------
# Example environment file for the `api` project.
#
# Copy this file to `.env.api` and fill in real values for local development:
#   cp .env.api.example .env.api
#
# `.env.api` is GIT-IGNORED (never commit real secrets). This `.example` lists
# every variable the api project reads, with placeholder/sample values.
# Variables are validated at boot by `envValidationJoiSchema`; required ones
# (no default) fail startup when missing.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production. Optional (default: development).
NODE_ENV=development

# HTTP port the API listens on. Optional (default: 3000).
PORT=3000

# --- PostgreSQL connection ---
# Host. Required.
DATABASE__HOST=localhost
# Port. Optional (default: 5432).
DATABASE__PORT=5432
# Username. Required.
DATABASE__USERNAME=postgres
# Password. Required. (Use the value from docker-compose.yml for local dev.)
DATABASE__PASSWORD=changeme
# Database name. Required.
DATABASE__NAME=everfit

# Mount OpenAPI + Scalar UI at /api/docs when "true". Optional (default: false).
API_DOCUMENT__ENABLED=false
