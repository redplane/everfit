# Dockerfile for the "api" project (Everfit Workout Logging API).
# Build:  docker build -f Dockerfile-api -t everfit-api .
# Run:    docker run -p 3000:3000 everfit-api

# ---------- Builder ----------
FROM node:22-alpine AS builder

# pnpm is the required package manager for this workspace.
RUN corepack enable

WORKDIR /workspace

# Install dependencies first to leverage Docker layer caching.
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Copy the rest of the workspace and build the api app.
# The build emits dist/apps/api with main.js and a self-contained
# package.json (pinned runtime deps) via generatePackageJson.
COPY . .
RUN pnpm nx build api --configuration=production

# ---------- Runtime ----------
FROM node:22-alpine AS runtime

RUN corepack enable

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000

WORKDIR /app

# Copy the build output (main.js + generated package.json with pinned deps),
# then install only the production dependencies.
COPY --from=builder /workspace/dist/apps/api ./
RUN pnpm install --prod

# Must match the port the app listens on (apps/api/src/main.ts defaults to 3000).
EXPOSE 3000

CMD ["node", "main.js"]
